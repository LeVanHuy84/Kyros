# ==============================================================================
# AI EXECUTIVE ASSISTANT ENVIRONMENT VARIABLES (DEVELOPMENT / LOCAL)
# ==============================================================================

# Docker Compose Settings
IMAGE_REPOSITORY=ai-executive-assistant

# PostgreSQL Database Settings
POSTGRES_DB=assistant_db
POSTGRES_USER=assistant_user
POSTGRES_PASSWORD=assistant_secure_pwd

# Backend Database Connection Variables
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/assistant_db
SPRING_DATASOURCE_USERNAME=assistant_user
SPRING_DATASOURCE_PASSWORD=assistant_secure_pwd

# Redis Cache Settings
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# JWT Security Settings (Must be at least 256-bits long)
JWT_SECRET=super_secret_jwt_key_at_least_256_bits_long_super_secret_jwt_key_at_least_256_bits_long
APP_SECURITY_JWT_SECRET=super_secret_jwt_key_at_least_256_bits_long_super_secret_jwt_key_at_least_256_bits_long
APP_SECURITY_JWT_EXPIRATION_MS=86400000

# SMTP Real Mail Server Settings (Gmail SMTP example)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-dev-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-specific-password

# Port Settings
PORT=8080
FRONTEND_PORT=3000

# Application URLs
APP_FRONTEND_URL=http://localhost:3000
# Base URL of the backend API (Render). Used by the browser AND by the Vercel
# keep-alive cron (/api/keepalive) to warm the backend every 10 minutes.
VITE_API_URL=http://localhost:8080
