# ==========================================
# KYROS AI EXECUTIVE ASSISTANT - ENV EXAMPLE
# ==========================================

# Spring Profile
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/assistant_db
SPRING_DATASOURCE_USERNAME=assistant_user
SPRING_DATASOURCE_PASSWORD=assistant_secure_pwd

# Redis Configuration
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Security & Backend Vault Master Encryption Key (AES-256-GCM)
# Replace this with a strong 32+ character secret key in production!
APP_SECURITY_VAULT_MASTER_KEY=KyrosMasterVaultKey256BitsSecretProductionKey!

# Frontend URL
APP_FRONTEND_URL=http://localhost:3000
