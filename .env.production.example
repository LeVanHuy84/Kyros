# ==============================================================================
# AI EXECUTIVE ASSISTANT ENVIRONMENT VARIABLES (PRODUCTION)
# ==============================================================================

# Production Docker Registry Settings
IMAGE_REPOSITORY=your-docker-registry.com/assistant

# Active Spring Profile (must match application-prod.yml)
SPRING_PROFILES_ACTIVE=prod

# Database Production Settings
DB_USERNAME=kyros_admin
DB_PASSWORD=YOUR_STRONG_PRODUCTION_DATABASE_PASSWORD_HERE

# Backend Database Production Connection Settings
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-prod-host:5432/kyros_db
SPRING_DATASOURCE_USERNAME=kyros_admin
SPRING_DATASOURCE_PASSWORD=YOUR_STRONG_PRODUCTION_DATABASE_PASSWORD_HERE

# Redis Production Settings (Upstash format supported via SPRING_REDIS_URL)
SPRING_DATA_REDIS_HOST=redis-prod-host
SPRING_DATA_REDIS_PORT=6379
SPRING_REDIS_URL=redis://default:password@us1-xxx.upstash.io:6379

# AI/LLM Provider API Keys (ADR-0012: Groq primary, Gemini fallback)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# JWT Production Secrets (CRITICAL: Change these to a secure random 256-bit string)
JWT_SECRET=YOUR_SECURE_RANDOM_256BIT_SECRET_STRING_HERE
APP_SECURITY_JWT_SECRET=YOUR_SECURE_RANDOM_256BIT_SECRET_STRING_HERE
APP_SECURITY_JWT_EXPIRATION_MS=86400000

# Real SMTP Production Mail Settings (SendGrid SMTP example)
SPRING_MAIL_HOST=smtp.sendgrid.net
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=apikey
SPRING_MAIL_PASSWORD=YOUR_SENDGRID_OR_SMTP_PROVIDER_API_KEY

# Production Domain Configurations
APP_FRONTEND_URL=https://app.kyros.ai
VITE_API_URL=https://api.kyros.ai
