# ==============================================================================
# Kyros AI Executive Assistant - Frontend Angular Environment Configuration
# ==============================================================================
# Sao chép tệp này thành .env trong thư mục frontend-angular/ để ghi đè cấu hình local.
# Lưu ý: Tuyệt đối KHÔNG lưu trữ API keys bí mật hoặc credentials backend ở đây!
# ==============================================================================

# Backend API Endpoint
# - Mặc định dùng relative path '/api' để reverse proxy qua dev-server (proxy.conf.json) hoặc Nginx
# - Hoặc truyền URL tuyệt đối khi deploy standalone (VD: http://localhost:8080/api hoặc https://api.yourdomain.com/api)
NG_APP_API_URL=/api

# WebSocket / SSE Endpoint
# - Mặc định dùng relative path '/ws'
# - Hoặc URL tuyệt đối (VD: ws://localhost:8080/ws hoặc wss://api.yourdomain.com/ws)
NG_APP_WS_URL=/ws

# Application Metadata
NG_APP_NAME="Kyros AI Executive Assistant"
NG_APP_VERSION=1.0.0

# Default UI Settings
# - Ngôn ngữ mặc định: 'vi' (Tiếng Việt) | 'en' (English)
NG_APP_DEFAULT_LANG=vi

# - Giao diện mặc định: 'light' | 'dark' | 'system'
NG_APP_DEFAULT_THEME=system
