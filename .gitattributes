# Set default behavior to automatically normalize line endings
* text=auto

# Declare files that should always have LF line endings on check-in
*.java text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
